# ---- Database (the only required infrastructure) ----
# Any Postgres works. Two common setups:
#
# Local (test everything with zero accounts):
#   docker run -d --name ferdowsi-pg -p 5432:5432 -e POSTGRES_PASSWORD=ferdowsi postgres:16
#   DATABASE_URL=postgres://postgres:ferdowsi@localhost:5432/postgres
#
# Supabase (when you deploy): use the connection string from your project's
# Connect panel. On Vercel, pick the "Transaction pooler" string.
DATABASE_URL=postgres://postgres:ferdowsi@localhost:5432/postgres

# ---- LLM (writer + researcher + humanizer validator) ----
ANTHROPIC_API_KEY=
# Optional per-stage model overrides (cost/quality tradeoffs):
# MODEL_RESEARCH=claude-sonnet-5
# MODEL_WRITE=claude-opus-4-8
# MODEL_VALIDATE=claude-sonnet-5

# ---- Auth ----
# Admin dashboard password (/admin). In `next dev` you can leave it unset.
ADMIN_SECRET=
# Protects the cron endpoints (Vercel sends it automatically when set).
CRON_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-site.com

# ---- Hero images (optional; off by default) ----
# none | custom (implement your provider in lib/image-gen.ts)
IMAGE_PROVIDER=none

# ---- Promos ----
# The dashboard's locked tabs show a banner for the managed version, fetched
# from a remote manifest so it stays current. Set to "off" to disable the
# remote fetch entirely.
# FERDOWSI_PROMOS=off
# PROMO_MANIFEST_URL=

# ---- Move 5 (yours to build — see the guide) ----
# When you wire the GSC/GA nightly pulls, their credentials go here:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GSC_SITE_URL=sc-domain:your-site.com
# GA4_PROPERTY_ID=
